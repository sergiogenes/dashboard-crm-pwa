# Dependencias de Node
node_modules/

# Directorios de compilación de Next.js y empaquetados
.next/
out/
build/
dist/

# Variables de entorno y credenciales (Seguridad y ahorro de tokens)
.env
.env.local
.env.development.local
.env.test
.env.test.local
*.pem
*.key

# Reportes y resultados de pruebas automatizadas (Playwright)
playwright-report/
test-results/
coverage/

# Archivos y metadatos de Git
.git/
.gitignore

# Cachés del Linter y formateadores
.eslintcache
.prettiercache

# Archivos de logs de ejecución y errores
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos generados dinámicamente en public por next-pwa
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
